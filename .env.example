# ==============================================
# SAINTARA APPLICATION CONFIGURATION
# ==============================================
# IMPORTANT: This is a template file for production deployment
# Copy this file to .env and configure all required values
# ==============================================

# Application Configuration
APP_NAME=Saintara
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Logging Configuration
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# CRITICAL: PostgreSQL is the recommended database for production
# SECURITY: Set a STRONG password - NEVER use empty password in production!
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=saintara_db
DB_USERNAME=postgres
DB_PASSWORD=your-strong-password-here

# Alternative MySQL configuration (if needed)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=saintara_db
# DB_USERNAME=root
# DB_PASSWORD=your-strong-password-here

# ==============================================
# SESSION CONFIGURATION (SECURITY CRITICAL)
# ==============================================
# SECURITY: All session settings must be configured for production
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict
SESSION_HTTP_ONLY=true

# ==============================================
# CACHE & QUEUE CONFIGURATION
# ==============================================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==============================================
# MAIL CONFIGURATION
# ==============================================
# For production, configure SMTP settings
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-mail-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@saintara.com"
MAIL_FROM_NAME="${APP_NAME}"

# Development option:
# MAIL_MAILER=log

# ==============================================
# AWS S3 CONFIGURATION (Optional)
# ==============================================
# Configure if using S3 for file storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==============================================
# MIDTRANS PAYMENT GATEWAY CONFIGURATION
# ==============================================
# CRITICAL: Replace with REAL Midtrans credentials!
# Get your keys from: https://dashboard.midtrans.com/settings/config-info
# SECURITY: Never commit real keys to version control!
#
# For Sandbox Testing:
# - Use sandbox keys from Midtrans dashboard
# - Set MIDTRANS_IS_PRODUCTION=false
#
# For Production:
# - Use production keys from Midtrans dashboard
# - Set MIDTRANS_IS_PRODUCTION=true
# - NEVER use placeholder values!

MIDTRANS_SERVER_KEY=your-server-key-here
MIDTRANS_CLIENT_KEY=your-client-key-here
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

# ==============================================
# FRONTEND CONFIGURATION (Vite)
# ==============================================
VITE_APP_NAME="${APP_NAME}"
VITE_MIDTRANS_CLIENT_KEY="${MIDTRANS_CLIENT_KEY}"
VITE_MIDTRANS_IS_PRODUCTION="${MIDTRANS_IS_PRODUCTION}"

# ==============================================
# SECURITY NOTES
# ==============================================
# 1. Generate APP_KEY using: php artisan key:generate
# 2. Use strong database password (min 16 chars, mixed case, numbers, symbols)
# 3. Replace all placeholder Midtrans keys with real values
# 4. Ensure SESSION_SECURE_COOKIE=true (requires HTTPS)
# 5. Set APP_DEBUG=false in production
# 6. Set APP_ENV=production
# 7. Use LOG_LEVEL=error or warning (not debug)
# 8. Never commit .env file to version control
# 9. Use environment-specific .env files for different deployments
# 10. Regularly rotate API keys and passwords
#
# PRODUCTION CHECKLIST:
# ✓ APP_DEBUG=false
# ✓ APP_ENV=production
# ✓ DB_PASSWORD set to strong password
# ✓ SESSION_ENCRYPT=true
# ✓ SESSION_SECURE_COOKIE=true
# ✓ MIDTRANS keys replaced with real values
# ✓ HTTPS enabled on your domain
# ✓ All placeholder values replaced
# ==============================================
